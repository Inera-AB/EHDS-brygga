       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "DiagnosisType → Condition.category" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Mappning av RIVTA diagnosisType (HD/BY) från kv_diagnostyp till FHIR Condition.category[diagnostyp]" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
