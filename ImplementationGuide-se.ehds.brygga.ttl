       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Minimalt exempel på en patient som uppfyller SEEHDSPatient-profilen." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "https://fhir.inera.se/StructureDefinition/se-ehds-patient" ;
