       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Asserted Date" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Administrativt datum när diagnosen registrerades kliniskt (author-time).\nMappas från EPS-extensionen extension:assertedDate i GetDiagnosis.\nSkiljer sig från recordedDate (systemtidsstämpel) och onsetDateTime (klinisk debut)." ] ;
